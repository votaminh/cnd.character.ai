CONTENT_SETTINGS:!1,ASSURANCE_METADATA:!1},currentUser:null,deviceType:"desktop",revision:"3eac8975697e858083b3f77d12e810633697eb0c",categoryList:{0:"genre-uncategorized",1:"genre-teen-fiction",2:"genre-poetry",3:"genre-fantasy",4:"genre-romance",5:"genre-science-fiction",6:"genre-fanfiction",7:"genre-humor",8:"genre-mystery-thriller",9:"genre-horror",10:"genre-classics",11:"genre-adventure",12:"genre-paranormal",13:"genre-spiritual",14:"genre-action",16:"genre-non-fiction",17:"genre-short-stories",18:"genre-vampire",19:"genre-random",21:"genre-general-fiction",22:"genre-werewolf",23:"genre-historical-fiction",24:"genre-chick-lit"},isWpWeb:!0,afpConfig:{hostAccountId:"pub-9506570645588245"}},currentUser:null,theme:6,gtmData:[],testGroups:{SPECIAL_AD_EXEMPT:!1,USE_IMAGE_MOD:!1,GDPR_ADS_EXPERIENCE:!1,USE_33ACROSS:!1,EXCLUDE_PREBID_PARTNERS:!1,DELAY_ADS:!1,PREBID_BETA:!1,USE_KEVEL:!1,USE_AFP:!1,AD_ELIGIBILITY:!1,NEW_ONBOARDING_1:!0,HOME_IMPROVEMENTS:!0,MOBILE_CONTENT_SETTINGS:!1,ASSURANCE_METADATA:!1},revision:"3eac8975697e858083b3f77d12e810633697eb0c",siteRoot:"https://www.wattpad.com",supportDomain:"https://support.wattpad.com",safetyPortalDomain:"https://safetyportal.wattpad.com",facebookAppId:"2582347323",referer:"https://www.google.com/",usPrivacy:"",googleFedCMRollout:!0},"routes/story.$storyid":{meta:{url:"https://www.wattpad.com/story/374896135-the-space-between-us-s4-five-hargreeves",description:`Six years have passed since everyone was brought to the 'new universe,' and Five and Y/n are still going on stronger, even stronger than before. As CIA agents, they're currently investigating as suspicious group called "The Keepers"

A birthday party calls everyone together, but when Viktor doesn't arrive, they all get a little suspicious and go out to search for him and end up meeting a man who is missing his daughter: Jennifer Grossman.

They're sent on a mission to find the girl after mysteriously gaining their powers back, but are met with many unexpected events, including meeting the one man they wish they wouldn't: Sir Reginald Hargreeves.

Do they end up finding the girl? Will Five and Y/n find out what it is The Keepers are up to? Will they even survive this new timeline? Read to find out in the final part of 'The Space Between Us' series!`,keywords:"allison,allisonhargreeves,ben,benhargreeves,diego,diegohargreeves,five,fivehargreeves,fivehargreevesxreader,fivexreader,klaus,klaushargreeves,luther,lutherhargreeves,theumbrellaacademy,theumbrellaacademyxreader,tuaxreader,viktor,viktorhargreeves,Action",title:"The Space Between Us (S4) || Five Hargreeves",image:"https://img.wattpad.com/cover/374896135-256-k456665.jpg",banner:"https://www.wattpad.com/banner?id=374896135&v=865000",facebook:!1,twitter:!1,apple:!1,pinterest:!1,googlePlus:!1,otherCrawler:!1,deeplink:{ios:"wattpad://story/374896135",android:"wattpad://story/374896135"},story:{votes:126,author:"Beebo",category:"Action",tags:[{id:"allison",name:"allison"},{id:"allisonhargreeves",name:"allisonhargreeves"},{id:"ben",name:"ben"},{id:"benhargreeves",name:"benhargreeves"},{id:"diego",name:"diego"},{id:"diegohargreeves",name:"diegohargreeves"},{id:"five",name:"five"},{id:"fivehargreeves",name:"fivehargreeves"},{id:"fivehargreevesxreader",name:"fivehargreevesxreader"},{id:"fivexreader",name:"fivexreader"},{id:"klaus",name:"klaus"},{id:"klaushargreeves",name:"klaushargreeves"},{id:"luther",name:"luther"},{id:"lutherhargreeves",name:"lutherhargreeves"},{id:"theumbrellaacademy",name:"theumbrellaacademy"},{id:"theumbrellaacademyxreader",name:"theumbrellaacademyxreader"},{id:"tuaxreader",name:"tuaxreader"},{id:"viktor",name:"viktor"},{id:"viktorhargreeves",name:"viktorhargreeves"},{name:"Action"}]},structuredData:`{"@context":"http://schema.org","@type":"Article","about":"Action","author":{"name":"Beebo","url":"https://www.wattpad.com/user/its-beebo"},"accountablePerson":{"name":"Beebo","url":"https://www.wattpad.com/user/its-beebo"},"copyrightHolder":{"name":"Beebo","url":"https://www.wattpad.com/user/its-beebo"},"copyrightYear":"2024","dateCreated":"2024-08-14","datePublished":"2024-08-14","dateModified":"2024-11-22","description":"Six years have passed since everyone was brought to the 'new universe,' and Five and Y/n are still going on stronger, even stronger than before. As CIA agents, they're currently investigating as suspicious group called \\"The Keepers\\"\\n\\nA birthday party calls everyone together, but when Viktor doesn't arrive, they all get a little suspicious and go out to search for him and end up meeting a man who is missing his daughter: Jennifer Grossman.\\n\\nThey're sent on a mission to find the girl after mysteriously gaining their powers back, but are met with many unexpected events, including meeting the one man they wish they wouldn't: Sir Reginald Hargreeves.\\n\\nDo they end up finding the girl? Will Five and Y/n find out what it is The Keepers are up to? Will they even survive this new timeline? Read to find out in the final part of 'The Space Between Us' series!","commentCount":55,"discussionUrl":"https://www.wattpad.com/story/374896135-the-space-between-us-s4-five-hargreeves#story-tabs","genre":"https://www.wattpad.com/stories/action","headline":"The Space Between Us (S4) || Five Hargreeves","inLanguage":"en_US","interactionStatistic":4676,"isAccessibleForFree":true,"isFamilyFriendly":true,"keywords":"allison,allisonhargreeves,ben,benhargreeves,diego,diegohargreeves,five,fivehargreeves,fivehargreevesxreader,fivexreader,klaus,klaushargreeves,luther,lutherhargreeves,theumbrellaacademy,theumbrellaacademyxreader,tuaxreader,viktor,viktorhargreeves,Action,eBooks,reading,stories,fiction","publisher":{"@type":"Organization","name":"Wattpad","legalName":"Wattpad Corp","foundingDate":"2006","foundingLocation":"Toronto, Ontario, Canada","areaServed":"Global","logo":{"@type":"ImageObject","url":"https://www.wattpad.com/img/logos/wp-logo-orange.png"},"url":"https://www.wattpad.com"},"publishingPrinciples":"https://support.wattpad.com/hc/en-us/articles/200774334-Content-Guidelines","thumbnailUrl":"https://img.wattpad.com/cover/374896135-256-k456665.jpg","typicalAgeRange":"13-","image":"https://img.wattpad.com/cover/374896135-256-k456665.jpg","name":"The Space Between Us (S4) || Five Hargreeves","url":"https://www.wattpad.com/story/374896135-the-space-between-us-s4-five-hargreeves","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.wattpad.com/story/374896135-the-space-between-us-s4-five-hargreeves"}}`,robots:"index,follow"},title:"The Space Between Us (S4) || Five Hargreeves - Beebo - Wattpad",story:{id:"374896135",title:"The Space Between Us (S4) || Five Hargreeves",length:92541,createDate:"2024-08-12T16:57:44Z",voteCount:126,readCount:4676,commentCount:55,language:{id:1,name:"English"},user:{name:"Beebo",avatar:"https://img.wattpad.com/useravatar/its-beebo.128.294153.jpg",username:"its-beebo",numFollowers:218},description:`Six years have passed since everyone was brought to the 'new universe,' and Five and Y/n are still going on stronger, even stronger than before. As CIA agents, they're currently investigating as suspicious group called "The Keepers"

A birthday party calls everyone together, but when Viktor doesn't arrive, they all get a little suspicious and go out to search for him and end up meeting a man who is missing his daughter: Jennifer Grossman.

They're sent on a mission to find the girl after mysteriously gaining their powers back, but are met with many unexpected events, including meeting the one man they wish they wouldn't: Sir Reginald Hargreeves.

Do they end up finding the girl? Will Five and Y/n find out what it is The Keepers are up to? Will they even survive this new timeline? Read to find out in the final part of 'The Space Between Us' series!`,cover:"https://img.wattpad.com/cover/374896135-256-k456665.jpg",cover_timestamp:"2024-08-12T16:57:45Z",completed:!1,categories:[14,0],tags:["allison","allisonhargreeves","ben","benhargreeves","diego","diegohargreeves","five","fivehargreeves","fivehargreevesxreader","fivexreader","klaus","klaushargreeves","luther","lutherhargreeves","theumbrellaacademy","theumbrellaacademyxreader","tuaxreader","viktor","viktorhargreeves"],rating:1,copyright:1,url:"https://www.wattpad.com/story/374896135-the-space-between-us-s4-five-hargreeves",firstPartId:1469219073,numParts:10,firstPublishedPart:{id:1469219073,createDate:"2024-08-14T00:23:56Z"},lastPublishedPart:{id:1497620278,createDate:"2024-11-22T00:31:04Z"},parts:[{id:1469219073,title:"Please Read This",url:"https://www.wattpad.com/1469219073-the-space-between-us-s4-five-hargreeves-please",draft:!1,createDate:"2024-08-14T00:23:56Z",length:470,isNew:!1},{id:1469538119,title:"☕️ Prologue/Cast ☕️",url:"https://www.wattpad.com/1469538119-the-space-between-us-s4-five-hargreeves-%E2%98%95%EF%B8%8F",draft:!1,createDate:"2024-08-14T00:24:02Z",length:2452,isNew:!1},{id:1469538198,title:"☕️ Chapter One ☕️",url:"https://www.wattpad.com/1469538198-the-space-between-us-s4-five-hargreeves-%E2%98%95%EF%B8%8F-chapter",draft:!1,createDate:"2024-08-14T00:24:07Z",length:16007,isNew:!1},{id:1470913776,title:"☕️ Chapter Two ☕️",url:"https://www.wattpad.com/1470913776-the-space-between-us-s4-five-hargreeves-%E2%98%95%EF%B8%8F-chapter",draft:!1,createDate:"2024-08-19T18:28:59Z",length:14897,isNew:!1},{id:1471821462,title:"☕️ Chapter Three ☕️",url:"https://www.wattpad.com/1471821462-the-space-between-us-s4-five-hargreeves-%E2%98%95%EF%B8%8F-chapter",draft:!1,createDate:"2024-08-23T17:38:17Z",length:13013,isNew:!1},{id:1477581688,title:"☕️ Chapter Fou